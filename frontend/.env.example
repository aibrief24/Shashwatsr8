# Copy to .env and fill in real values. .env is gitignored; this file is not.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

EXPO_PUBLIC_BACKEND_URL=https://your-backend.example.com

# AdMob test-ads switch. Fail-safe: ONLY the exact string 'true' enables Google
# test native ads. Anything else (including unset) means REAL ads.
EXPO_PUBLIC_USE_TEST_ADS=true

# ── .env vs .env.production ──────────────────────────────────────────────────
# Expo loads .env* by NODE_ENV, highest priority first:
#   .env.production.local  >  .env.local  >  .env.production  >  .env
#
#   .env             — everyday/dev values. Keeps EXPO_PUBLIC_USE_TEST_ADS=true
#                      so local runs show Google test ads.
#   .env.production  — release-only overrides, loaded when NODE_ENV=production
#                      (local release builds, e.g. `expo run:android
#                      --variant release`). Sets EXPO_PUBLIC_USE_TEST_ADS=false
#                      so store builds request REAL ad units.
#
# Both are gitignored (.env.* in the root .gitignore); only this example file
# is tracked. Create .env.production locally before any release build:
#   echo 'EXPO_PUBLIC_USE_TEST_ADS=false' > .env.production
#
# EAS cloud builds do NOT see these files (gitignored, not uploaded) — they
# get EXPO_PUBLIC_USE_TEST_ADS from the per-profile `env` block in eas.json.
#
# Caution: a variable already exported in your shell beats every .env file, and
# .env.local (if you create one) beats .env.production.
