{
  "expo": {
    "name": "AIBrief24",
    "slug": "aibrief24",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aibrief24",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aibrief24.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to share with articles",
        "NSPhotoLibraryUsageDescription": "Allow access to save and share article images.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving article images to your photo library.",
        "NSUserTrackingUsageDescription": "AIBrief24 uses this to show ads relevant to your interests, such as technology and AI products, and to measure ad performance. This helps keep the app free.",
