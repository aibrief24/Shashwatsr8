{
  "expo": {
    "name": "AIBrief24",
    "slug": "aibrief24",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aibrief24",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aibrief24.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to share with articles",
        "NSPhotoLibraryUsageDescription": "Allow access to save and share article images.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving article images to your photo library.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "versionCode": 15,
      "package": "com.aibrief24.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#020617"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6497331440034971~8131854655",
          "iosAppId": "ca-app-pub-6497331440034971~1117847954"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3B82F6"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1308022248155682",
          "clientToken": "17301dbe6eaa25a3899b1832c7d7e40e",
          "displayName": "AIBrief24",
          "scheme": "fb1308022248155682",
          "autoLogAppEventsEnabled": true,
          "advertiserIDCollectionEnabled": true,
          "isAutoInitEnabled": true
        }
      ],
      "expo-tracking-transparency"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4aa3746-6261-41f1-bb3d-b0a87b6f0f6e"
      }
    },
    "owner": "sr8mu"
  }
}
